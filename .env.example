HOST=0.0.0.0
PORT=4317
AUTH_USERNAME=admin
AUTH_PASSWORD=change-me
SESSION_SECRET=change-this-session-secret
SESSION_TTL_SECONDS=28800
COOKIE_SECURE=false
PANE_HISTORY_LINES=200
PANE_STREAM_INTERVAL_MS=1000
CORS_ORIGIN=*
# HTTPS — both must be set together. Required for clipboard image paste from
# non-localhost (browsers gate the Clipboard API behind a secure context).
# Generate a LAN-trusted cert with `mkcert` (e.g. `mkcert -install &&
# mkcert 192.168.x.x localhost`) and point these at the resulting files.
# HTTPS_KEY=./certs/dev-key.pem
# HTTPS_CERT=./certs/dev-cert.pem
DATABASE_URL="file:./data/app.db"
