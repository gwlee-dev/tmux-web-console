{
  "name": "tmux-web-console",
  "version": "0.1.0",
  "private": true,
  "description": "Node-only web UI and JSON API for controlling tmux sessions remotely",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test",
    "check": "node --check src/server.js && node --check src/tmux.js"
  },
  "engines": {
    "node": ">=20"
  }
}
