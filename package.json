{
  "name": "tmux-web-console",
  "version": "0.1.0",
  "private": true,
  "packageManager": "yarn@4.14.1",
  "description": "Fastify API with a React + shadcn/ui frontend for controlling tmux sessions remotely",
  "type": "module",
  "scripts": {
    "dev": "node --watch-path=src --watch-path=vite.config.ts --watch-preserve-output src/server.js --dev",
    "dev:server": "node --watch-path=src --watch-path=vite.config.ts --watch-preserve-output src/server.js --dev",
    "build": "tsc -b && vite build",
    "prestart": "yarn build",
    "start": "node src/server.js",
    "test": "vitest run && playwright test",
    "test:unit": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "check": "node --check src/server.js && node --check src/tmux.js && node --check src/pty-websocket.js && yarn typecheck && yarn build"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fastify/multipart": "^10.0.0",
    "@fastify/static": "^9.1.2",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^5.2.6",
    "@fastify/vite": "^9.0.1",
    "@fontsource-variable/geist": "^5.2.8",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fastify": "^5.8.5",
    "fastify-plugin": "^5.1.0",
    "lucide-react": "^1.8.0",
    "next-themes": "^0.4.6",
    "node-pty": "^1.1.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "shadcn": "^4.3.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.3",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tailwindcss/vite": "^4.2.3",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.5",
    "typescript": "^6.0.3",
    "vite": "^8.0.9",
    "vitest": "^4.1.5"
  }
}
